{
  "buildCommand": "pnpm run build",
  "outputDirectory": "build",
  "framework": "docusaurus-2",
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/skills/generate-a-spec/boomerang-prompt.md",
      "destination": "/skills/generate-a-spec/BOOMERANG.md",
      "permanent": true
    },
    {
      "source": "/skills/save-your-progress/SKILL.md",
      "destination": "/skills/save-my-progress/SKILL.md",
      "permanent": true
    },
    {
      "source": "/concepts/agentic-project-management",
      "destination": "https://superprojects.wiki/concepts/agentic-project-management",
      "permanent": true
    },
    {
      "source": "/concepts/project-resumability",
      "destination": "https://superprojects.wiki/concepts/project-resumability",
      "permanent": true
    },
    {
      "source": "/generators/start-agentic-project/GENERATE.md",
      "destination": "https://superprojects.wiki/generators/start-agentic-project/GENERATE.md",
      "permanent": true
    }
  ]
}
